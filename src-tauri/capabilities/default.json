{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Potato Tomato",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "allow-sync-tray-recent",
    "allow-get-puller-base-url",
    "allow-ensure-puller",
    "allow-get-dev-harness-mode",
    "allow-tray-lifecycle",
    "allow-open-external-url",
    "allow-apk-self-update",
    "allow-native-identity",
    "allow-game-frames",
    "allow-offline-files",
    "allow-webview-crash",
    "core:app:allow-version",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/puller-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
